# Secrets and local overrides
secrets/.env
secrets/*.local
*.local

# Rendered / machine-specific outputs (optional backups)
*.bak
.DS_Store

# Tool-managed skill: installed/regenerated by `no-mistakes init`, not vendored
core/skills/no-mistakes/

# Eval run artifacts — raw per-run jsonl is regenerable; the committed summary is
# evals/BENCHMARKS.md (produced by evals/report.py). Keep the heavy artifacts out.
evals/results/
__pycache__/

# Editor
.idea/
.vscode/
