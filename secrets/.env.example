# Copy to secrets/.env (gitignored) and customize.
#
# Format: simple KEY=value, one per line. This file is read directly by the merge
# tools (not `source`d by a shell), so there is NO shell expansion: write `~` for
# your home dir (it is expanded), not `$HOME`; no `$(...)`, no `${VAR}`, no inline
# `# comments` after a value. Surrounding single/double quotes are stripped.

# Tool paths are auto-detected per machine (via `which` / `npm root -g`).
# Uncomment ONLY to override the detected value on an unusual setup.

# Node / MCP launchers
# NPX=/opt/homebrew/bin/npx
# NODE_PATH=/opt/homebrew/lib/node_modules
# PATH=/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin

# lean-ctx (install: brew install yvgude/lean-ctx/lean-ctx)
# LEAN_CTX=/opt/homebrew/bin/lean-ctx
# LEAN_CTX_DATA_DIR=~/.lean-ctx

# MongoDB MCP (optional — if using mongodb plugin)
# MDB_MCP_CONNECTION_STRING=mongodb+srv://...
# MDB_MCP_READ_ONLY=true

# Atlassian MCP (optional — OAuth via plugin UI)
# ATLASSIAN_SITE_URL=https://yoursite.atlassian.net

# Slack MCP (optional — OAuth via plugin UI)

# GitNexus — uses npx; no API key required for local graph
