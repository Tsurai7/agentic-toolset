# Copy to secrets/.env (gitignored) and customize.

# Node / MCP launchers
NPX=/opt/homebrew/bin/npx
NODE_PATH=/opt/homebrew/lib/node_modules
PATH=/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin

# MongoDB MCP (optional — if using mongodb plugin)
# MDB_MCP_CONNECTION_STRING=mongodb+srv://...
# MDB_MCP_READ_ONLY=true

# Atlassian MCP (optional — OAuth via plugin UI)
# ATLASSIAN_SITE_URL=https://yoursite.atlassian.net

# Slack MCP (optional — OAuth via plugin UI)

# GitNexus — uses npx; no API key required for local graph
