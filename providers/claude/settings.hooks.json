{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [{ "type": "command", "command": "__AGENTIC_ROOT__/providers/claude/hooks/shell-guard.sh" }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Edit|Write|MultiEdit)$",
        "hooks": [{ "type": "command", "command": "__AGENTIC_ROOT__/providers/claude/hooks/edit-lint.sh" }]
      }
    ]
  },
  "permissions": {
    "allow": []
  }
}
